# ─────────────────────────────────────────────────────────────────────────────
# CampusBot AI  —  Environment Configuration Template
# Copy this file to .env and fill in all values before running.
# NEVER commit your .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="CampusBot AI"
APP_VERSION="1.0.0"
ENVIRONMENT="development"          # development | staging | production
DEBUG=true
API_V1_PREFIX="/api/v1"

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql+asyncpg://campusbot:campusbot_pass@localhost:5432/campusbot_db"

# ── Security / JWT ────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="CHANGE_ME_generate_a_strong_secret_key_at_least_32_chars"
JWT_SECRET="CHANGE_ME_separate_jwt_secret_key_for_token_signing"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
ALLOWED_HOSTS="localhost,127.0.0.1"

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL="INFO"                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_DIR="logs"

# ── Enterprise Embedding Pipeline ─────────────────────────────────────────────
EMBEDDING_PROVIDER="bge"
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
VECTOR_STORE="faiss"
BATCH_SIZE=32
EMBEDDING_DIMENSION=384
FAISS_INDEX_PATH="faiss_data/faiss_index.bin"

# ── Enterprise Retriever ──────────────────────────────────────────────────────
RETRIEVER_PROVIDER="faiss"
DEFAULT_RETRIEVAL_LIMIT=5
DEFAULT_RELEVANCE_THRESHOLD=0.5

# ── Enterprise LLM Orchestrator ───────────────────────────────────────────────
LLM_PROVIDER="ollama"
OLLAMA_HOST="http://ollama:11434"
LLM_MODEL="gemma3:4b"
LLM_TEMPERATURE=0.7
LLM_TOP_P=0.9
LLM_TOP_K=40
LLM_MAX_TOKENS=4096
LLM_REPEAT_PENALTY=1.1
LLM_NUM_CTX=8192
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60.0
